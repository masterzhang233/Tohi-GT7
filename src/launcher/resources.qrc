<RCC>
 <qresource prefix="/icons">
  <file alias="check.svg">icons/check.svg</file>
  <file alias="chevron-down-light.svg">icons/chevron-down-light.svg</file>
  <file alias="chevron-down-dark.svg">icons/chevron-down-dark.svg</file>
  <file alias="chevron-up-light.svg">icons/chevron-up-light.svg</file>
  <file alias="chevron-up-dark.svg">icons/chevron-up-dark.svg</file>
  <file alias="edit-configuration.svg">icons/edit-configuration.svg</file>
  <file alias="global-settings.svg">icons/global-settings.svg</file>
  <file alias="input-mapping.svg">icons/input-mapping.svg</file>
  <file alias="racing-wheel.svg">icons/racing-wheel.svg</file>
  <file alias="refresh.svg">icons/refresh.svg</file>
  <file alias="remove-configuration.svg">icons/remove-configuration.svg</file>
 </qresource>
 <qresource prefix="/styles">
  <file alias="launcher.qss">styles/launcher.qss</file>
 </qresource>
 <qresource prefix="/images">
  <file alias="gt7-official-logo.png">images/gt7-official-logo.png</file>
  <file alias="gt7-official-hero.jpg">images/gt7-official-hero.jpg</file>
  <file alias="gt7-super-gt.jpg">images/gt7-super-gt.jpg</file>
 </qresource>
</RCC>
