/* Flat UWP-style geometry, with the user's system colors and font. */
QWidget { border-radius: 0px; }
QLabel[class="pageHeading"] { font-size: 20pt; font-weight: 600; }
QLabel#gt7_feature_title { font-size: 15pt; font-weight: 600; }
QLabel#gt7_release_badge { font-size: 9pt; }
QLabel#game_library_title { font-size: 11pt; font-weight: 600; }

QFrame#navigation_panel { background: palette(alternate-base); border: 0; }
QFrame#navigation_panel QPushButton {
    text-align: left; min-height: 26px; padding: 8px 12px;
    border: 1px solid transparent; background: transparent;
}
QFrame#navigation_panel QPushButton:hover { background: palette(midlight); }
QFrame#navigation_panel QPushButton:checked { background: palette(highlight); color: palette(highlighted-text); }
QFrame#navigation_panel QPushButton:focus { border-color: palette(text); }

QPushButton, QToolButton {
    color: palette(button-text); background: palette(button);
    border: 1px solid palette(mid); border-radius: 0px;
    min-height: 22px; padding: 4px 12px;
}
QPushButton:hover, QToolButton:hover { background: palette(midlight); border-color: palette(text); }
QPushButton:pressed, QToolButton:pressed { background: palette(mid); }
QPushButton:focus, QToolButton:focus { border-color: palette(highlight); }
QPushButton:default, QPushButton#gt7_start_button:enabled {
    background: palette(highlight); color: @accent-text@; border-color: palette(highlight);
}
QPushButton:disabled, QToolButton:disabled { color: @disabled-text@; border-color: palette(midlight); }
QToolButton { min-width: 24px; padding: 4px; }
QToolButton[autoRaise="true"] { background: transparent; border-color: transparent; }
QToolButton[autoRaise="true"]:hover { background: palette(midlight); border-color: palette(mid); }
QWidget#settings_page QPushButton { min-width: 300px; min-height: 28px; text-align: left; padding: 6px 14px; }

QLineEdit, QComboBox, QAbstractSpinBox {
    background: palette(base); color: palette(text); border: 1px solid palette(mid);
    border-radius: 0px; min-height: 22px; padding: 3px 8px;
    selection-background-color: palette(highlight); selection-color: palette(highlighted-text);
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { border-color: palette(text); }
QLineEdit:focus, QComboBox:focus, QAbstractSpinBox:focus { border-color: palette(highlight); }
QLineEdit:disabled, QComboBox:disabled, QAbstractSpinBox:disabled { color: @disabled-text@; background: palette(window); }
QComboBox { padding-right: 28px; }
QComboBox::drop-down { width: 24px; border: 0; background: transparent; }
QComboBox::down-arrow { image: url(@arrow-down@); width: 12px; height: 8px; }
QComboBox QAbstractItemView { padding: 3px; outline: 0; }
QAbstractSpinBox { padding-right: 22px; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button { width: 22px; height: 14px; border: 0; border-radius: 0px; subcontrol-origin: border; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(@arrow-up@); width: 10px; height: 6px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(@arrow-down@); width: 10px; height: 6px; }

QCheckBox, QRadioButton { min-height: 24px; spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid palette(mid); background: palette(base); }
QCheckBox::indicator:hover { border-color: palette(text); }
QCheckBox::indicator:checked { image: url(:/icons/check.svg); background: palette(highlight); border-color: palette(highlight); }
QCheckBox::indicator:indeterminate { background: palette(highlight); border: 4px solid palette(base); }
QCheckBox::indicator:disabled { background: palette(window); border-color: palette(midlight); }
QCheckBox::indicator:checked:disabled { background: palette(shadow); border-color: palette(mid); }
QCheckBox:focus { color: palette(highlight); }

QAbstractItemView {
    background: palette(base); color: palette(text); border: 1px solid palette(mid);
    border-radius: 0px; selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text); alternate-background-color: palette(alternate-base);
}
QTreeWidget::item, QListWidget::item, QListView::item { padding: 5px 6px; border: 0; }
QTreeWidget::item:hover, QListWidget::item:hover, QListView::item:hover { background: palette(midlight); }
QTreeWidget::item:selected, QListWidget::item:selected, QListView::item:selected {
    background: palette(highlight); color: palette(highlighted-text);
}
QHeaderView::section {
    background: palette(button); color: palette(button-text); border: 0;
    border-bottom: 1px solid palette(mid); padding: 7px 6px; font-weight: 600;
}
QTextEdit, QPlainTextEdit { border: 1px solid palette(mid); background: palette(base); color: palette(text); }

QGroupBox { border: 1px solid palette(midlight); margin-top: 14px; padding: 10px 10px 8px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 10px; padding: 0px 4px; }
QGroupBox QWidget { font-weight: 400; }
QTabWidget::pane { border: 1px solid palette(midlight); }
QTabBar::tab { background: palette(button); border: 1px solid transparent; padding: 8px 14px; }
QTabBar::tab:selected { background: palette(base); border-color: palette(midlight); }
QTabBar::tab:hover { background: palette(midlight); }

QMenu, QMenuBar, QToolTip { background: palette(window); color: palette(window-text); border: 1px solid palette(mid); border-radius: 0px; }
QMenu { padding: 4px 0; }
QMenu::item { padding: 7px 28px; }
QMenu::item:selected, QMenuBar::item:selected { background: palette(highlight); color: palette(highlighted-text); }
QMenu::item:disabled { color: @disabled-text@; }
QMenu::separator { height: 1px; background: palette(midlight); margin: 4px 8px; }
QToolTip { padding: 5px 8px; }

QScrollArea { border: 0; }
QScrollArea QWidget#settings_scroll_content,
QScrollArea QWidget#wheel_scroll_content,
QScrollArea#graphics_scroll, QWidget#graphics_scroll_content { background: palette(window); }
QScrollBar:vertical { background: palette(window); width: 12px; margin: 0; border: 0; }
QScrollBar:horizontal { background: palette(window); height: 12px; margin: 0; border: 0; }
QScrollBar::handle:vertical { background: palette(mid); min-height: 28px; margin: 2px; }
QScrollBar::handle:horizontal { background: palette(mid); min-width: 28px; margin: 2px; }
QScrollBar::handle:hover { background: palette(text); }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QProgressBar { border: 1px solid palette(midlight); background: palette(base); text-align: center; }
QProgressBar::chunk { background: palette(highlight); }

QFrame#gt7_feature_panel QLabel, QFrame#graphics_brand_panel QLabel { color: white; background: transparent; }
