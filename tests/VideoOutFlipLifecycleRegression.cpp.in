struct Presenter {
    struct Frame { std::atomic<unsigned> discarded {0}; };
    struct Layer { Frame* frame; int bus; bool premultiplied_alpha; bool hold; };
    std::mutex gate_mutex;
    std::condition_variable gate_changed;
    bool entered = false, released = false;
    std::atomic<unsigned> calls {0}, clear_calls {0};
    std::atomic<unsigned> refresh_calls {0};
    std::atomic<bool> paused {false};
    Frame blank;
    std::array<Frame*, 4> current {};
    RenderContext renderer;
    RenderContext& Renderer() { return renderer; }
    bool IsGuestPaused() const { return paused.load(); }
    bool NeedsSystemOverlayRefresh() const { return false; }
    bool PresentLastFrame() { ++refresh_calls; return true; }
    Frame& PrepareBlankFrame(uint32_t, uint32_t, bool) { return blank; }
    void Present(Frame& frame) {
        const Layer layer {&frame, 0, false, false};
        Present(std::span(&layer, 1));
    }
    void Discard(Frame& frame) {
        if (frame.discarded.fetch_add(1) != 0) throw std::runtime_error("double frame release");
    }
    void Present(std::span<const Layer> layers) {
        bool desktop_changed = false;
        for (const auto& layer: layers) {
            if (layer.hold && current[layer.bus] != nullptr && current[layer.bus] != layer.frame) {
                if (layer.frame) Discard(*layer.frame);
            } else {
                if (current[layer.bus] && current[layer.bus] != layer.frame) Discard(*current[layer.bus]);
                current[layer.bus] = layer.frame;
                desktop_changed = true;
            }
        }
        ++calls;
        if (!desktop_changed) return;
        std::unique_lock lock(gate_mutex);
        entered = true;
        gate_changed.notify_all();
        gate_changed.wait(lock, [this] { return released; });
    }
    bool AwaitPresent() {
        std::unique_lock lock(gate_mutex);
        return gate_changed.wait_for(lock, 2s, [this] { return entered; });
    }
    void ReleasePresent() {
        std::lock_guard lock(gate_mutex);
        released = true;
        gate_changed.notify_all();
    }
    void ClearLayer(int bus) {
        ++clear_calls;
        if (current[bus]) Discard(*std::exchange(current[bus], nullptr));
    }
};
}
