namespace Common {
// This fixture exercises the unmodified lifecycle with opt-in source tracing off.
// Fail if a production method reaches the diagnostic clock/sink while disabled.
namespace SourceTrace {
enum class Kind : uint32_t { FlipSubmit, FlipPrepare, FlipReady, Process, Command, Fault };
struct Event {
    Kind kind {};
    uint32_t flags = 0, tid = 0;
    uint64_t begin_ns = 0, end_ns = 0, work_end_ns = 0;
    uint64_t submission_id = 0, request_id = 0, arg0 = 0, arg1 = 0;
};
bool Enabled() noexcept { return false; }
uint64_t NowNs() { throw std::runtime_error("source tracing must stay disabled"); }
void Record(Event) { throw std::runtime_error("source tracing must stay disabled"); }
}
inline std::atomic<unsigned> active_waits {0};
struct Mutex {
    std::mutex value;
    void Lock() { value.lock(); }
    void Unlock() { value.unlock(); }
    bool TryLock() { return value.try_lock(); }
};
struct LockGuard {
    Mutex& value;
    explicit LockGuard(Mutex& mutex): value(mutex) { value.Lock(); }
    ~LockGuard() { value.Unlock(); }
};
struct CondVar {
    std::condition_variable changed;
    void Wait(Mutex* mutex) {
        std::unique_lock lock(mutex->value, std::adopt_lock);
        ++active_waits;
        changed.wait(lock);
        --active_waits;
        (void)lock.release();
    }
    bool WaitFor(Mutex* mutex, uint32_t micros) {
        std::unique_lock lock(mutex->value, std::adopt_lock);
        const auto result = changed.wait_for(lock, std::chrono::microseconds(micros));
        (void)lock.release();
        return result != std::cv_status::timeout;
    }
    void Signal() { changed.notify_one(); }
    void SignalAll() { changed.notify_all(); }
};
struct Thread { static bool IsMainThread() { return true; } };
}
